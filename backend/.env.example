# ==============================================================================
# Maid Top Up Game - Backend Environment Variables Template
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# Provider Utama Aktif ('bv2shop' atau 'bahterastore')
ACTIVE_PROVIDER=bv2shop

# Provider BV2SHOP Credentials (https://bv2shop.com/api/v1)
BV2SHOP_BASE_URL=https://bv2shop.com/api/v1
BV2SHOP_API_KEY=
BV2SHOP_WEBHOOK_SECRET=

# Provider BahteraStore (Dinonaktifkan sementara, dapat diaktifkan kembali nanti)
# BAHTERASTORE_BASE_URL=https://api.bahterastore.id/
# BAHTERASTORE_API_KEY=

# Payment Gateway Credentials (Midtrans / Xendit / Tripay)
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_GATEWAY_MODE=sandbox

# JWT Secret untuk Autentikasi Admin
JWT_SECRET=your_jwt_secret_key_change_in_production

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:5173
